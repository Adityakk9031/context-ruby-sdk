      attr_reader country: ContextDev::Models::BrandSearchParams::country?

      def country=: (
        ContextDev::Models::BrandSearchParams::country
      ) -> ContextDev::Models::BrandSearchParams::country

      attr_reader language: ContextDev::Models::BrandSearchParams::language?

      def language=: (
        ContextDev::Models::BrandSearchParams::language
      ) -> ContextDev::Models::BrandSearchParams::language

      attr_reader query_by: ::Array[ContextDev::Models::BrandSearchParams::query_by]?

      def query_by=: (
        ::Array[ContextDev::Models::BrandSearchParams::query_by]
      ) -> ::Array[ContextDev::Models::BrandSearchParams::query_by]

      attr_reader tags: ::Array[String]?

      def tags=: (::Array[String]) -> ::Array[String]

      attr_reader typo_tolerance: Integer?

      def typo_tolerance=: (Integer) -> Integer

      def initialize: (
        query: String,
        ?autocomplete: bool,
        ?country: ContextDev::Models::BrandSearchParams::country,
        ?language: ContextDev::Models::BrandSearchParams::language,
        ?query_by: ::Array[ContextDev::Models::BrandSearchParams::query_by],
        ?tags: ::Array[String],
        ?typo_tolerance: Integer,
        ?request_options: ContextDev::request_opts
      ) -> void

      def to_hash: -> {
        query: String,
        autocomplete: bool,
        country: ContextDev::Models::BrandSearchParams::country,
        language: ContextDev::Models::BrandSearchParams::language,
        query_by: ::Array[ContextDev::Models::BrandSearchParams::query_by],
        tags: ::Array[String],
        typo_tolerance: Integer,
        request_options: ContextDev::RequestOptions
      }

