    type brand_search_params =
      {
        query: String,
        autocomplete: bool,
        country: ContextDev::Models::BrandSearchParams::country,
        language: ContextDev::Models::BrandSearchParams::language,
        query_by: ::Array[ContextDev::Models::BrandSearchParams::query_by],
        tags: ::Array[String],
        typo_tolerance: Integer
      }
      & ContextDev::Internal::Type::request_parameters

    class BrandSearchParams < ContextDev::Internal::Type::BaseModel
      extend ContextDev::Internal::Type::RequestParameters::Converter
